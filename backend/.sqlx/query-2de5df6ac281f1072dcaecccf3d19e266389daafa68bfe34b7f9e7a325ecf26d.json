  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                d.id,\n                d.year,\n                d.teacher,\n                d.exam_type,\n                d.is_answer,\n                d.num,\n                s.id AS \"subject_id!\",\n                s.faculty_id AS \"faculty_id!\",\n                s.major_id AS \"major_id!\",\n                s.grade AS \"grade!\",\n                s.term AS \"term!\"\n            FROM documents AS d\n                INNER JOIN subject_details AS s ON s.id = d.subject_id\n            WHERE d.id = $1\n        ",
